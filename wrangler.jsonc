{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "davidschunk-com",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "preview_urls": true,
  "routes": [
    {
      "pattern": "davidschunk.com/*",
      "zone_name": "davidschunk.com"
    },
    {
      "pattern": "www.davidschunk.com/*",
      "zone_name": "davidschunk.com"
    }
  ],
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}
